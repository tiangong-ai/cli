{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiangong.ai/data/manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "capabilityVersion",
    "minimumCliVersion",
    "providerId",
    "endpoints",
    "credentials",
    "limits",
    "diagnostics",
    "operations",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.data.manifest.v1" },
    "capabilityId": { "$ref": "#/$defs/id" },
    "capabilityVersion": { "$ref": "#/$defs/version" },
    "minimumCliVersion": { "$ref": "#/$defs/version" },
    "providerId": { "$ref": "#/$defs/id" },
    "endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "credentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/credential" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "live"],
      "properties": {
        "static": { "const": true },
        "live": { "type": "boolean" }
      }
    },
    "availability": { "$ref": "#/$defs/suspendedAvailability" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "suspendedAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode"],
      "properties": {
        "status": { "const": "suspended" },
        "reasonCode": { "$ref": "#/$defs/id" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutMs",
        "maxRequestBytes",
        "maxResponseBytes",
        "maxPages",
        "maxRecords",
        "maxRetries",
        "maxRetryDelayMs",
        "maxRedirects"
      ],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxRequestBytes": { "type": "integer", "minimum": 1 },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxPages": { "type": "integer", "minimum": 1 },
        "maxRecords": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "maxRetryDelayMs": { "type": "integer", "minimum": 0 },
        "maxRedirects": { "type": "integer", "minimum": 0 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointId",
        "baseUrl",
        "pathPrefixes",
        "allowedMethods",
        "allowedContentTypes"
      ],
      "properties": {
        "endpointId": { "$ref": "#/$defs/id" },
        "baseUrl": { "type": "string", "pattern": "^https://" },
        "pathPrefixes": { "$ref": "#/$defs/stringArray" },
        "allowedMethods": {
          "type": "array",
          "items": { "enum": ["GET", "POST"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedContentTypes": { "$ref": "#/$defs/stringArray" },
        "sessionCookies": { "enum": ["same-origin-memory"] }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialId", "environmentVariable", "required", "endpointIds", "injection"],
      "properties": {
        "credentialId": { "$ref": "#/$defs/id" },
        "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "required": { "type": "boolean" },
        "endpointIds": { "$ref": "#/$defs/stringArray" },
        "injection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name", "prefix"],
              "properties": {
                "kind": { "const": "header" },
                "name": { "type": "string", "minLength": 1 },
                "prefix": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "placeholder"],
              "properties": {
                "kind": { "const": "path-segment" },
                "placeholder": {
                  "type": "string",
                  "pattern": "^\\{[a-z][a-z0-9-]*\\}$"
                }
              }
            }
          ]
        }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "digest"],
      "properties": {
        "schemaId": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "operationVersion", "inputSchema", "outputSchema", "limits"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "operationVersion": { "$ref": "#/$defs/version" },
        "inputSchema": { "$ref": "#/$defs/schemaRef" },
        "outputSchema": { "$ref": "#/$defs/schemaRef" },
        "limits": { "$ref": "#/$defs/limits" },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "artifactOutput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "required"],
          "properties": {
            "kind": { "const": "directory" },
            "required": { "const": true }
          }
        }
      }
    }
  }
}
